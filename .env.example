# Generate a secure random string for Flask session encryption
FLASK_SECRET_KEY=replace_with_a_long_random_secret_string
FLASK_ENV=production

# Your Trello Power-Up / API credentials (from https://trello.com/power-ups/admin)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here

# The full callback URL on your Render domain
# Example: https://your-app-name.onrender.com/callback
CALLBACK_URL=https://your-app-name.onrender.com/callback
# ==========================================
# GENERAL FLASK / RENDER SETTINGS
# ==========================================
FLASK_SECRET_KEY=replace_with_a_long_random_secret_string
FLASK_ENV=production

# ==========================================
# 1. TRELLO CONFIG
# ==========================================
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here
CALLBACK_URL=https://your-app-name.onrender.com/callback

# ==========================================
# 2. NOTION CONFIG
# ==========================================
# Option A: For OAuth 2.0 Integration
NOTION_CLIENT_ID=your_notion_client_id_here
NOTION_CLIENT_SECRET=your_notion_client_secret_here
NOTION_REDIRECT_URI=https://your-app-name.onrender.com/notion/callback

# Option B: For Direct Integration Token (if skipping OAuth)
NOTION_TOKEN=secret_your_notion_internal_integration_token

# ==========================================
# 3. CLOUDFLARE CONFIG (OAUTH 2.0 & API)
# ==========================================
# For Cloudflare OAuth 2.0:
CLOUDFLARE_CLIENT_ID=your_cloudflare_client_id_here
CLOUDFLARE_CLIENT_SECRET=your_cloudflare_client_secret_here
CLOUDFLARE_REDIRECT_URI=https://your-app-name.onrender.com/cloudflare/callback

# For Direct API Token (optional fallback):
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
