# Generate a secure random string for Flask session encryption
FLASK_SECRET_KEY=replace_with_a_long_random_secret_string
FLASK_ENV=production

# Your Trello Power-Up / API credentials (from https://trello.com/power-ups/admin)
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here

# The full callback URL on your Render domain
# Example: https://your-app-name.onrender.com/callback
CALLBACK_URL=https://your-app-name.onrender.com/callback
